RewriteEngine On

# Force HTTPS (Hostinger + proxy compatible)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block sensitive files/dirs — return 403 (no existence leak)
RewriteRule ^\.env - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^\.gitignore$ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule ^private/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule \.(sql|log|zip)$ - [F,L]
RewriteRule \.(env|md)$ - [F,L]
RewriteRule ^(info|seed)\.php$ - [F,L]

# SEO: sitemap.xml is generated by sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Pretty URLs → real files (internal rewrite, preserves POST, no loop).
# Only routes with a known existing file are mapped. Unknown SEO slugs
# intentionally fall through to 404.php (honest 404, no guessing).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^translator/?$ translator.php [L]
RewriteRule ^chat/?$ chat.php [L]
RewriteRule ^kids/?$ kids.php [L]
RewriteRule ^dashboard/?$ dashboard.php [L]
RewriteRule ^guides/?$ guides.php [L]
RewriteRule ^guides/(restaurant|souk|taxi|family|travel)/?$ guides.php [L]
RewriteRule ^blog/?$ blog.php [L]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog.php?slug=$1 [L,QSA]
RewriteRule ^pricing/?$ pricing.php [L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^login/?$ login.php [L]
RewriteRule ^register/?$ register.php [L]
RewriteRule ^profile/?$ profile.php [L]
RewriteRule ^logout/?$ logout.php [L]
RewriteRule ^verify-email/?$ verify-email.php [L]

# Custom 404 (must stay last)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]
