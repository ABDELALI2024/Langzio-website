# Langzio Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Groq AI API ─────────────────────────────────────
GROQ_API_KEY=gsk_your_api_key_here

# ─── Database (MySQL on Hostinger) ───────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=langzio
DB_USER=root
DB_PASS=your_password_here

# ─── Trial Settings ──────────────────────────────────
TRIAL_DAYS=7

# ─── Email (Hostinger PHP mail) ──────────────────────
MAIL_ENABLED=false
MAIL_FROM=noreply@langzio.com
MAIL_FROM_NAME=Langzio

# ─── PayPal ─────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# ─── WhatsApp Provider (choose one) ─────────────────
# Options: ultramsg, wati, twilio
WHATSAPP_PROVIDER=ultramsg
WHATSAPP_API_KEY=your_api_key_here
WHATSAPP_FROM=14161234567

# UltraMsg (easiest for Hostinger)
ULTRAMSG_INSTANCE=instance1234

# Twilio (if using Twilio)
TWILIO_SID=your_twilio_sid

# ─── Cron Security ──────────────────────────────────
CRON_SECRET=change_this_to_a_random_secret

# ─── SEO / Canonical ─────────────────────────────────
CANONICAL_DOMAIN=https://langzio.com
