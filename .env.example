# Langzio Environment Configuration
# Copy this file to .env on the server and fill in real values.
# NEVER commit the real .env to Git.

# ─── Groq AI API ─────────────────────────────────────
GROQ_API_KEY=

# ─── Database (MySQL on Hostinger) ───────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ─── Trial Settings ──────────────────────────────────
TRIAL_DAYS=7

# ─── Email (Hostinger PHP mail) ──────────────────────
MAIL_ENABLED=false
MAIL_FROM=noreply@langzio.com
MAIL_FROM_NAME=Langzio

# ─── PayPal ─────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=

# ─── WhatsApp Provider (choose one) ─────────────────
# Options: ultramsg, wati, twilio
WHATSAPP_PROVIDER=ultramsg
WHATSAPP_API_KEY=
WHATSAPP_FROM=

# UltraMsg (easiest for Hostinger)
ULTRAMSG_INSTANCE=

# Twilio (if using Twilio)
TWILIO_SID=

# ─── Cron Security (required, min 32 random chars) ──
CRON_SECRET=

# ─── SEO / Canonical ─────────────────────────────────
CANONICAL_DOMAIN=https://langzio.com

# ─── Debug (local only, never enable in production) ──
# LANGZIO_DEBUG=1
